#!/usr/bin/env bpftrace
/*
 * Guardian-Alpha LSM Hook Latency Measurement (Simplified)
 * Kernel 6.12 EEVDF Scheduler Validation
 */

BEGIN {
    printf("========================================\n");
    printf("Guardian-Alpha LSM Latency Measurement\n");
    printf("Scheduler: EEVDF (Kernel 6.12+)\n");
    printf("Target: <100μs average\n");
    printf("========================================\n\n");
}

kprobe:security_bprm_check {
    @start[tid] = nsecs;
}

kretprobe:security_bprm_check /@start[tid]/ {
    $latency_us = (nsecs - @start[tid]) / 1000;
    
    // Store latency
    @latency_us = hist($latency_us);
    @min = min($latency_us);
    @max = max($latency_us);
    @avg = avg($latency_us);
    @total = count();
    
    delete(@start[tid]);
}

interval:s:10 {
    printf("\n--- Statistics (10s interval) ---\n");
    print(@latency_us);
    clear(@latency_us);
}

END {
    printf("\n========================================\n");
    printf("Final Statistics\n");
    printf("========================================\n");
    print(@total);
    print(@min);
    print(@max);
    print(@avg);
    printf("\nLatency Distribution:\n");
    print(@latency_us);
    printf("========================================\n");
}
