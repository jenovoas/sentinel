#!/usr/bin/env python3
import argparse
import subprocess
import json
import sys
import os

# Sentinel Docker Wrapper (sdocker)
# Purpose: Provide a safe, observable interface for AI-driven Docker management.

ALLOWED_Services = ["sentinel-core", "postgres", "redis", "nginx", "sentinel-relay"]

def run_docker_cmd(args):
    try:
        result = subprocess.run(
            ["docker"] + args,
            capture_output=True,
            text=True,
            check=True
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        return f"Error: {e.stderr}"

def status():
    # Returns JSON status of all containers for AI consumption
    raw = run_docker_cmd(["ps", "--format", "{{.Names}}|{{.Status}}|{{.State}}|{{.Ports}}"])
    containers = []
    if raw and "Error" not in raw:
        for line in raw.split('\n'):
            if not line: continue
            parts = line.split('|')
            containers.append({
                "name": parts[0],
                "status": parts[1],
                "state": parts[2],
                "ports": parts[3]
            })
    
    print(json.dumps(containers, indent=2))

def safe_restart(target):
    # Enforces safety policy: Only restart known services
    # In future: Check dependency graph (e.g. dont restart DB if API is active)
    
    print(f"🛡️  Sentinel Docker Guard: Analyzing restart request for '{target}'...")
    
    # 1. Semantic Check
    if target not in ALLOWED_Services and "all" != target:
        print(f"❌ DENIED: Service '{target}' is not in the Safe Whitelist.")
        print(f"   Allowed: {ALLOWED_Services}")
        sys.exit(1)
        
    # 2. Impact Analysis (Mock)
    # real impl would check 'docker stats' or active connections
    print(f"   ℹ️  Impact: Low (Service is isolated)")
    
    # 3. Execution
    print(f"🚀 Restarting {target}...")
    if target == "all":
        # Safe sequence
        print(run_docker_cmd(["compose", "restart"]))
    else:
        print(run_docker_cmd(["restart", target]))
        
    print("✅ Restart Complete.")

def logs(target, update=False):
    # Safe log retrieval (tail only)
    args = ["logs", "--tail", "100"]
    if update: args.append("-f")
    args.append(target)
    
    # Direct exec to allow streaming
    os.execvp("docker", ["docker"] + args)

def main():
    parser = argparse.ArgumentParser(description="Sentinel Docker Wrapper (sdocker)")
    subparsers = parser.add_subparsers(dest="command")
    
    # Status
    subparsers.add_parser("status", help="JSON status of containers")
    
    # Restart
    p_restart = subparsers.add_parser("safe-restart", help="Restart a service with safety checks")
    p_restart.add_argument("target", help="Container name or 'all'")
    
    # Logs
    p_logs = subparsers.add_parser("logs", help="View safe logs")
    p_logs.add_argument("target", help="Container name")
    
    args = parser.parse_args()
    
    if args.command == "status":
        status()
    elif args.command == "safe-restart":
        safe_restart(args.target)
    elif args.command == "logs":
        logs(args.target)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
