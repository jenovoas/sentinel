# Prometheus Configuration - Fenix Production
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: 'fenix-securepenguin'
    environment: 'production'

rule_files:
  - '/etc/prometheus/rules/*.yml'

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter-fenix'
    static_configs:
      - targets: ['node-exporter:9100'] # Usar nombre de servicio en la red interna

  - job_name: 'postgres'
    static_configs:
      - targets: ['postgres-exporter:9187']

  - job_name: 'redis'
    static_configs:
      - targets: ['redis-exporter:9121']

  - job_name: 'sentinel-cortex'
    static_configs:
      - targets: ['cortex:8000']
    metrics_path: '/metrics'
