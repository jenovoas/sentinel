# ==================================================================================
# docker-compose.fenix.yml — Stack Sentinel para Producción en Fenix (DEPURADO)
# ==================================================================================

services:

  # ── BASE DE DATOS ──────────────────────────────────────────────────────────────

  postgres:
    image: docker.io/library/postgres:16-alpine
    container_name: sentinel-postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-sentinel_user}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-sentinel_db}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./docker/postgres/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    networks:
      - sentinel_internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-sentinel_user} -d ${POSTGRES_DB:-sentinel_db}"]
      interval: 10s
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped

  redis:
    image: docker.io/library/redis:7-alpine
    container_name: sentinel-redis
    volumes:
      - redis_data:/data
    networks:
      - sentinel_internal
    command: redis-server --appendonly yes --requirepass ${REDIS_PASSWORD}
    deploy:
      resources:
        limits:
          memory: 256M
    restart: unless-stopped

  # ── BACKEND FASTAPI ────────────────────────────────────────────────────────────

  backend:
    build: 
      context: .
      dockerfile: backend/Dockerfile
    container_name: sentinel-backend
    environment:
      DATABASE_URL: postgresql+asyncpg://${POSTGRES_USER:-sentinel_user}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-sentinel_db}
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis:6379/0
      REDIS_MODE: standalone                          # MODO DEPURADO PARA FENIX
      FASTAPI_ENV: production
      SECRET_KEY: ${SECRET_KEY}
      LOG_LEVEL: ${LOG_LEVEL:-WARNING}
      GOOGLE_APPLICATION_CREDENTIALS: /app/credentials.json
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - /home/jnovoas/.config/gcloud/application_default_credentials.json:/app/credentials.json:ro
    networks:
      - sentinel_internal
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.sentinel-api.rule=Host(`sentinel-api.pinguinoseguro.cl`)"
      - "traefik.http.routers.sentinel-api.entrypoints=websecure"
      - "traefik.http.routers.sentinel-api.tls.certresolver=powerdns"
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped

  # ── WORKERS CELERY ─────────────────────────────────────────────────────────────

  celery_worker:
    build:
      context: .
      dockerfile: backend/Dockerfile.worker
    container_name: sentinel-celery-worker
    environment:
      DATABASE_URL: postgresql+asyncpg://${POSTGRES_USER:-sentinel_user}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-sentinel_db}
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis:6379/0
      REDIS_MODE: standalone
      CELERY_BROKER_URL: redis://:${REDIS_PASSWORD}@redis:6379/0
      CELERY_RESULT_BACKEND: redis://:${REDIS_PASSWORD}@redis:6379/1
    networks:
      - sentinel_internal
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped

  # ── OBSERVABILIDAD ─────────────────────────────────────────────────────────────

  prometheus:
    image: docker.io/prom/prometheus:latest
    container_name: sentinel-prometheus
    volumes:
      - ./observability/prometheus/prometheus.fenix.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    networks:
      - sentinel_internal
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.prometheus.rule=Host(`prometheus.pinguinoseguro.cl`)"
      - "traefik.http.routers.prometheus.entrypoints=websecure"
      - "traefik.http.routers.prometheus.tls.certresolver=powerdns"
    deploy:
      resources:
        limits:
          memory: 256M
    restart: unless-stopped

  grafana:
    image: docker.io/grafana/grafana:latest
    container_name: sentinel-grafana
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GF_ADMIN_PASSWORD}
      GF_AUTH_ANONYMOUS_ENABLED: "false"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./observability/grafana/grafana.fenix.ini:/etc/grafana/grafana.ini:ro
    networks:
      - sentinel_internal
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.grafana.rule=Host(`grafana.pinguinoseguro.cl`)"
      - "traefik.http.routers.grafana.entrypoints=websecure"
      - "traefik.http.routers.grafana.tls.certresolver=powerdns"
    deploy:
      resources:
        limits:
          memory: 256M
    restart: unless-stopped

volumes:
  postgres_data:
  redis_data:
  prometheus_data:
  grafana_data:

networks:
  sentinel_internal:
    driver: bridge
    internal: true
  proxy:
    external: true
