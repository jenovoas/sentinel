source_up_if_exists
dotenv_if_exists

# Detectar y activar entorno virtual Python si existe (.venv o venv)
watch_file .venv/bin/activate venv/bin/activate
if [ -f .venv/bin/activate ]; then
  source .venv/bin/activate
elif [ -f venv/bin/activate ]; then
  source venv/bin/activate
fi

# Agregar binarios locales de Node al PATH si existen
if [ -d node_modules/.bin ]; then
  PATH_add node_modules/.bin
fi
