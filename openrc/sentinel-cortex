#!/sbin/openrc-run

name="sentinel-cortex"
description="Sentinel Cortex API"
command="/usr/local/bin/sentinel-cortex"
command_user="jnovoas"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/sentinel/cortex.log"
error_log="/var/log/sentinel/cortex.err"

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log/sentinel
}

depend() {
    need net
    need docker
    after firewall
}
