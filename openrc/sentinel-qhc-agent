#!/sbin/openrc-run

name="sentinel-qhc-agent"
description="Sentinel QHC phase harmonic driver"
command="/usr/local/bin/qhc_agent"
command_user="jnovoas"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/sentinel/qhc.log"
error_log="/var/log/sentinel/qhc.err"

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log/sentinel
    checkpath --directory --owner jnovoas:jnovoas --mode 0750 /run/soma
    checkpath --file --owner jnovoas:jnovoas --mode 0640 "$output_log"
    checkpath --file --owner jnovoas:jnovoas --mode 0640 "$error_log"
}

depend() {
    need net
    need sentinel-cortex
}
