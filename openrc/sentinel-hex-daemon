#!/sbin/openrc-run

name="sentinel-hex-daemon"
description="Sentinel HEX daemon"
command="/usr/local/bin/hex_daemon"
command_user="jnovoas"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/sentinel/hex.log"
error_log="/var/log/sentinel/hex.err"

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log/sentinel
}

depend() {
    need net
    after sentinel-cortex
}
