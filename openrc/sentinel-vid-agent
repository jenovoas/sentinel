#!/sbin/openrc-run

name="sentinel-vid-agent"
description="Sentinel VID cooling agent"
command="/usr/local/bin/vid_agent"
command_user="jnovoas"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/sentinel/vid.log"
error_log="/var/log/sentinel/vid.err"

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log/sentinel
}

depend() {
    need net
    after sentinel-cortex
}
