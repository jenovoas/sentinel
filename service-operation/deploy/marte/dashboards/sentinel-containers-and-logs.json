{
  "id": null,
  "uid": "sentinel-containers-and-logs",
  "title": "Sentinel — Logs del Sistema y Auditoría (Loki)",
  "tags": ["sentinel", "logs", "loki", "journal", "security", "audit"],
  "timezone": "browser",
  "schemaVersion": 29,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tasa de Ingesta por Nodo y Servicio (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (node, service) (rate({node=~\"fenix|marte\", job=~\"systemd-journal|docker-container|auditd\"}[1m]))",
          "legendFormat": "{{node}} {{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "lines/s" } },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs de Servicios Sentinel (journald)",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{node=~\"fenix|marte\", job=\"systemd-journal\", service=~\"sentinel.*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 10 }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Auditoría de Seguridad, Intentos SSH y Comandos Sudo",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{node=~\"fenix|marte\", job=~\"systemd-journal|auditd\"} |~ \"(?i)(sudo|sshd|failed|auth|forbidden|intercept|wal)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs de Contenedores de Fenix (JSON Docker)",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{node=\"fenix\", job=\"docker-container\"} | json | line_format \"{{.log}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 10 }
    }
  ]
}
