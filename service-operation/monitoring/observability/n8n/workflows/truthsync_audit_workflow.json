{
    "name": "TruthSync Audit - Quantum Verification",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "truthsync-audit",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "webhook-trigger",
            "name": "TruthSync Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "webhookId": "truthsync-audit"
        },
        {
            "parameters": {
                "keepOnlySet": true,
                "values": {
                    "string": [
                        {
                            "name": "verified",
                            "value": "true"
                        },
                        {
                            "name": "reason",
                            "value": "Quantum coherent signature validated against archival nodes."
                        },
                        {
                            "name": "timestamp",
                            "value": "={{ new Date().toISOString() }}"
                        }
                    ],
                    "boolean": [
                        {
                            "name": "verified",
                            "value": true
                        }
                    ]
                },
                "options": {}
            },
            "id": "validation-logic",
            "name": "Validate Signature",
            "type": "n8n-nodes-base.set",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify($json) }}",
                "options": {}
            },
            "id": "response-node",
            "name": "Return Verdict",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        }
    ],
    "connections": {
        "TruthSync Webhook": {
            "main": [
                [
                    {
                        "node": "Validate Signature",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Validate Signature": {
            "main": [
                [
                    {
                        "node": "Return Verdict",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "meta": {
        "instanceId": "sentinel-truthsync-audit"
    }
}