{
    "name": "AIOpsShield - Air Gap Workflow",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "aiops-ingest",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "webhook-trigger",
            "name": "Webhook Trigger",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "webhookId": "aiops-shield-ingest"
        },
        {
            "parameters": {
                "url": "=http://backend:8000/api/security/sanitize",
                "authentication": "none",
                "requestMethod": "POST",
                "jsonParameters": true,
                "options": {},
                "bodyParametersJson": "={{ JSON.stringify({ prompt: $json.body.log_message }) }}"
            },
            "id": "aiops-shield-sanitizer",
            "name": "AIOpsShield Sanitizer",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                450,
                300
            ],
            "notes": "CRITICAL: Air Gap pre-LLM\nBlocks AIOpsDoom attacks before reaching Ollama"
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.is_safe }}",
                            "value2": true
                        }
                    ]
                }
            },
            "id": "decision-node",
            "name": "Is Safe?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                650,
                300
            ],
            "notes": "Decision: Safe logs → Ollama\nUnsafe logs → Alert & Block"
        },
        {
            "parameters": {
                "url": "=http://ollama:11434/api/generate",
                "authentication": "none",
                "requestMethod": "POST",
                "jsonParameters": true,
                "options": {},
                "bodyParametersJson": "={{ JSON.stringify({ model: 'llama2', prompt: $json.sanitized_prompt || $json.body.log_message, stream: false }) }}"
            },
            "id": "ollama-llm",
            "name": "Ollama LLM",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                850,
                200
            ],
            "notes": "Only sanitized logs reach here"
        },
        {
            "parameters": {
                "url": "=http://backend:8000/api/alerts/aiops-attack",
                "authentication": "none",
                "requestMethod": "POST",
                "jsonParameters": true,
                "options": {},
                "bodyParametersJson": "={{ JSON.stringify({ threat_type: 'AIOpsDoom', blocked_patterns: $json.blocked_patterns, original_log: $json.body.log_message, timestamp: new Date().toISOString() }) }}"
            },
            "id": "alert-node",
            "name": "Alert AIOpsDoom Attack",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                850,
                400
            ],
            "notes": "CRITICAL ALERT: AIOpsDoom attack blocked"
        },
        {
            "parameters": {
                "url": "=http://backend:8000/api/aiops/decision",
                "authentication": "none",
                "requestMethod": "POST",
                "jsonParameters": true,
                "options": {},
                "bodyParametersJson": "={{ JSON.stringify({ llm_response: $json.response, original_log: $json.body.log_message, decision_context: { sanitized: true, timestamp: new Date().toISOString() } }) }}"
            },
            "id": "execute-decision",
            "name": "Execute AI Decision",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1050,
                200
            ],
            "notes": "Execute decision from LLM"
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ status: 'success', decision: $json.decision, sanitized: true }) }}"
            },
            "id": "response-success",
            "name": "Response Success",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1250,
                200
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ status: 'blocked', reason: 'AIOpsDoom attack detected', blocked_patterns: $json.blocked_patterns }) }}",
                "options": {
                    "responseCode": 403
                }
            },
            "id": "response-blocked",
            "name": "Response Blocked",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1050,
                400
            ]
        }
    ],
    "connections": {
        "Webhook Trigger": {
            "main": [
                [
                    {
                        "node": "AIOpsShield Sanitizer",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "AIOpsShield Sanitizer": {
            "main": [
                [
                    {
                        "node": "Is Safe?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Safe?": {
            "main": [
                [
                    {
                        "node": "Ollama LLM",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Alert AIOpsDoom Attack",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Ollama LLM": {
            "main": [
                [
                    {
                        "node": "Execute AI Decision",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Execute AI Decision": {
            "main": [
                [
                    {
                        "node": "Response Success",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Alert AIOpsDoom Attack": {
            "main": [
                [
                    {
                        "node": "Response Blocked",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "staticData": null,
    "tags": [
        {
            "name": "security",
            "id": "security-tag"
        },
        {
            "name": "aiops",
            "id": "aiops-tag"
        }
    ],
    "meta": {
        "instanceId": "sentinel-cortex-aiops-shield"
    }
}