[Unit]
Description=Sentinel High-Performance eBPF Relay
After=network.target

[Service]
Type=simple
ExecStart=/home/jnovoas/sentinel/guardian-alpha/sentinel_relay
Restart=always
RestartSec=1
StandardOutput=append:/var/log/sentinel_relay.log
StandardError=append:/var/log/sentinel_relay.err
CPUQuota=10%
MemoryMax=100M
WatchdogSec=30s

[Install]
WantedBy=multi-user.target
