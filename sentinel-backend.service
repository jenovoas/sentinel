[Unit]
Description=Sentinel Backend FastAPI Service
After=network.target

[Service]
Type=simple
User=jnovoas
WorkingDirectory=/home/jnovoas/sentinel/backend
ExecStart=/bin/bash -c 'source /home/jnovoas/sentinel/venv_test/bin/activate && exec /home/jnovoas/sentinel/backend/entrypoint.sh'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
