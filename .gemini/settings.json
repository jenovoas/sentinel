{
  "mcpServers": {
    "code-review-graph": {
      "command": "sh",
      "args": [
        "-c",
        "rep=$(git rev-parse --show-toplevel 2>/dev/null || pwd); if command -v code-review-graph >/dev/null 2>&1; then exec code-review-graph serve --repo \"$rep\"; else exec uvx code-review-graph serve --repo \"$rep\"; fi"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.gemini/hooks/crg-session-start.sh\"",
            "name": "code-review-graph status",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.gemini/hooks/crg-update.sh\"",
            "name": "code-review-graph update",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
