# Sentinel Project - Environment Variables Template
# Copy this file to .env and fill in the actual values

# Database
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel_db

# Redis
REDIS_PASSWORD=

# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=WARNING

# AI Services
# Cortex REST API & Runtime
PORT=8000
RUST_LOG=info
QHC_SOCKET_PATH=/run/soma/qhc.sock

# Backups
SENTINEL_BACKUP_DIR=/var/lib/sentinel/backups
SENTINEL_BACKUP_RETENTION_DAYS=30
SENTINEL_BACKUP_ENCRYPTION_ENABLED=false
SENTINEL_BACKUP_S3_ENABLED=false
SENTINEL_BACKUP_MINIO_ENABLED=false
SENTINEL_BACKUP_WEBHOOK_ENABLED=false

# Neural Guard & Observabilidad
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
N8N_URL=http://127.0.0.1:5678
REDIS_URL=redis://127.0.0.1:6379
ENABLE_THERMAL_COUPLING=true
SSH_BRUTEFORCE_THRESHOLD=5
NGINX_5XX_THRESHOLD=10

# Monitoring UI (Grafana / n8n)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=
N8N_USER=admin
N8N_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=https://cortex.pinguinoseguro.cl/api
