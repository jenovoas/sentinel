# Sentinel Project - Environment Variables Template
# Copy this file to .env and fill in the actual values

# Database
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel_db

# Redis
REDIS_PASSWORD=

# Security
SECRET_KEY=
ALGORITHM=HS256
JWT_ISSUER=sentinel-auth
JWT_AUDIENCE=sentinel-cortex
SENTINEL_WS_ALLOWED_ORIGINS=https://sentinel.pinguinoseguro.cl
# Fenix WireGuard address. The API is published only on this host address.
FENIX_WIREGUARD_IP=10.88.0.1
SENTINEL_BACKEND_PORT=8000
LOG_LEVEL=WARNING

# AI Services
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_MODEL=gemini-2.0-flash-001

# Monitoring
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Workflows / Automation
N8N_USER=admin
N8N_PASSWORD=
TRAEFIK_BASIC_AUTH=

# Python Path
PYTHONPATH=.
