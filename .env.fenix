# .env.fenix — Variables de entorno para producción Fenix
# COPIAR a .env en el servidor Fenix y completar los valores
# NO subir al repositorio (ya está en .gitignore)

# ── PostgreSQL ─────────────────────────────────
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA
POSTGRES_DB=sentinel_db

# ── Redis ──────────────────────────────────────
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# ── Backend ────────────────────────────────────
SECRET_KEY=CAMBIAR_POR_SECRET_KEY_MINIMO_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=WARNING

# ── Google AI ──────────────────────────────────
GOOGLE_CLOUD_PROJECT=gen-lang-client-0933512124
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_MODEL=gemini-2.0-flash-001

# ── Grafana ────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# ── n8n ────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA
