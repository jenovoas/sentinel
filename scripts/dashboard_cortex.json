{
  "dashboard": {
    "id": null,
    "title": "Sentinel Cortex - Bio-Resonance & Telemetry",
    "tags": ["sentinel", "cortex", "production"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Physical CPU Thermal Noise Celsius",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "dftkpum31qm80a" },
        "targets": [{ "expr": "sentinel_cpu_temperature_celsius", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "celsius", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] } } }
      },
      {
        "id": 2,
        "title": "LiquidLattice Memory 3x3 Retention Score EXP-009",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "dftkpum31qm80a" },
        "targets": [{ "expr": "sentinel_liquid_lattice_retention_score", "refId": "A" }],
        "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.72 }] } } }
      },
      {
        "id": 3,
        "title": "Total Raw Energy in Lattice",
