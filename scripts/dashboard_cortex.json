        "targets": [{ "expr": "sentinel_lattice_total_energy", "refId": "A" }]
      },
      {
        "id": 4,
        "title": "Live Ring-0 eBPF Interceptions & Systemd Logs",
        "type": "logs",
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
        "datasource": { "type": "loki", "uid": "fftiutkvocmbka" },
        "targets": [{ "expr": "{job=\"sentinel_file_logs\"}", "refId": "A" }]
      }
