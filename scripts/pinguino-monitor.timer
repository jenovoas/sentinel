[Unit]
Description=Timer para Monitor de Sitios Críticos - Pinguino Seguro
Documentation=file:///home/jnovoas/Desarrollo/sentinel/docs/POST_MORTEM_2026_03_20_PINGUINOSEGURO_DOWN.md

[Timer]
# Ejecutar cada 1 minuto
OnBootSec=1min
OnUnitActiveSec=1min

# Persistencia: si se pierde una ejecución, ejecutar al siguiente boot
Persistent=true

# Unit a activar
Unit=pinguino-monitor.service

[Install]
WantedBy=timers.target
