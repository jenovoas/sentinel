# ============================================================================
# Sentinel TUI - AI Provider Configuration
# ============================================================================

# AI Provider Selection
# Options: "ollama" (local) or "antigravity" (Google Gemini)
SENTINEL_AI_PROVIDER=ollama

# ============================================================================
# Ollama Configuration (Local AI)
# ============================================================================
# Default: Uses system Ollama at http://localhost:11434
# No additional configuration needed

# ============================================================================
# Antigravity Configuration (Google AI Studio / Gemini)
# ============================================================================

# Option 1: Direct Google AI Studio API
# Get your key at: https://makersuite.google.com/app/apikey
# GOOGLE_AI_API_KEY=your-api-key-here

# Option 2: HTTP Basic Auth (Custom Antigravity Proxy)
# ANTIGRAVITY_URL=https://your-proxy.com
# ANTIGRAVITY_USERNAME=your-username
# ANTIGRAVITY_PASSWORD=your-password

# Gemini Model Selection
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-pro
ANTIGRAVITY_MODEL=gemini-1.5-flash

# ============================================================================
# Backend Configuration
# ============================================================================
BACKEND_URL=http://localhost:8000

# ============================================================================
# Usage Examples
# ============================================================================

# Example 1: Use local Ollama (default)
# SENTINEL_AI_PROVIDER=ollama

# Example 2: Use Google Gemini Flash (fast, free tier)
# SENTINEL_AI_PROVIDER=antigravity
# GOOGLE_AI_API_KEY=AIzaSy...
# ANTIGRAVITY_MODEL=gemini-1.5-flash

# Example 3: Use Google Gemini Pro (more capable)
# SENTINEL_AI_PROVIDER=antigravity
# GOOGLE_AI_API_KEY=AIzaSy...
# ANTIGRAVITY_MODEL=gemini-1.5-pro

# Example 4: Use Antigravity Proxy with Basic Auth
# SENTINEL_AI_PROVIDER=antigravity
# ANTIGRAVITY_URL=https://proxy.example.com
# ANTIGRAVITY_USERNAME=myuser
# ANTIGRAVITY_PASSWORD=mypass
# ANTIGRAVITY_MODEL=gemini-1.5-flash
