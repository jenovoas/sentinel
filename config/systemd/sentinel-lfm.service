[Unit]
Description=Sentinel LFM 2.5 Liquid Foundation Model Server (Vulkan GPU)
After=network.target

[Service]
Type=simple
ExecStart=/home/jnovoas/Apps/llama.cpp/build/bin/llama-server -m /home/jnovoas/Apps/models/LFM2.5-2.6B-Q4_K_M.gguf -ngl 99 -c 4096 --host 127.0.0.1 --port 8080 -cb
Restart=on-failure
RestartSec=5s
Environment=GGML_VULKAN_DEVICE=0

[Install]
WantedBy=default.target
