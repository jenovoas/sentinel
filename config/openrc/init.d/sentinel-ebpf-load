#!/sbin/openrc-run

name="sentinel-ebpf-load"
description="Sentinel eBPF guardians, XDP, TC and Gamma loader"
start() {
    ebegin "Loading Sentinel eBPF guardians"
    /opt/sentinel/ebpf/load.sh
    eend $?
}

stop() {
    return 0
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log/sentinel /var/run/sentinel
}

depend() {
    need net
    after firewall
    before sentinel-cortex sentinel-ebpf-forwarder
}
