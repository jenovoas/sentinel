#!/sbin/openrc-run
# Reenviador ringbufs cortex_events (guardian + me60os) → ebpf_trace.log (NDJSON).
# Mantiene los fds abiertos (consumidores adjuntos) y alimenta el trace.

name="sentinel-ringbuf-forwarder"
description="Sentinel ringbuf cortex_events forwarder"
command="/usr/local/bin/ringbuf_forwarder"
command_args="/sys/fs/bpf/cortex_events /var/log/sentinel/ebpf_trace.log /sys/fs/bpf/cortex_events_exec"
command_user="root"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/sentinel/ringbuf-forwarder.log"
error_log="/var/log/sentinel/ringbuf-forwarder.err"

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log/sentinel
    # bpffs es efímero: re-pinear mapas en cada arranque.
    local n=0
    for id in $(bpftool map show 2>/dev/null | awk '/ name cortex_events /{gsub(/:/,"",$1); print $1}'); do
        n=$((n + 1))
        if [ "$n" -eq 1 ]; then
            [ -e /sys/fs/bpf/cortex_events ] || bpftool map pin id "$id" /sys/fs/bpf/cortex_events
        else
            [ -e /sys/fs/bpf/cortex_events_exec ] || bpftool map pin id "$id" /sys/fs/bpf/cortex_events_exec
        fi
    done
    local wl
    wl=$(bpftool map show 2>/dev/null | awk '/ name ai_whitelist_ma/{gsub(/:/,"",$1); print $1; exit}')
    if [ -n "$wl" ]; then
        mkdir -p /sys/fs/bpf/sentinel
        [ -e /sys/fs/bpf/sentinel/whitelist_map ] || bpftool map pin id "$wl" /sys/fs/bpf/sentinel/whitelist_map
    fi
}

depend() {
    need net
    after sentinel-ebpf-load
}
