#!/sbin/openrc-run

name="sentinel-deployment-executor"
description="Restricted Docker Compose executor for Sentinel deployments"
command="/usr/local/bin/deployment-executor-helper"
command_user="root"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/sentinel/deployment-executor.log"
error_log="/var/log/sentinel/deployment-executor.err"

start_pre() {
    checkpath --directory --owner root:root --mode 0750 /run/sentinel /var/log/sentinel /var/lib/sentinel/tenants
    checkpath --directory --owner root:root --mode 0750 /usr/local/share/sentinel/templates
}

start_post() {
    if [ -S /run/sentinel/deployment-executor.sock ]; then
        chown root:sentinel-orchestrator /run/sentinel/deployment-executor.sock
        chmod 0660 /run/sentinel/deployment-executor.sock
    fi
}

depend() {
    need net
    after docker sentinel-stack
}
