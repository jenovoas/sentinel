[Unit]
Description=Sentinel Guardian Cognitive eBPF LSM
After=local-fs.target
Before=sentinel-cortex.service mycnetd.service mycnet-batmesh.service
RequiresMountsFor=/sys/fs/bpf

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/sentinel-ebpf-bootstrap
ExecStop=/usr/local/libexec/sentinel-guardian-rollback --detach
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
