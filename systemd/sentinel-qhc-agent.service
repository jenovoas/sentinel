[Unit]
Description=Sentinel QHC Agent (Phase Harmonic Driver)
After=network.target

[Service]
Type=simple
User=jnovoas
Group=linuxuser
ExecStartPre=+/usr/bin/install -d -o jnovoas -g linuxuser -m 2770 /run/soma
ExecStart=/home/jnovoas/.local/bin/qhc_agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
